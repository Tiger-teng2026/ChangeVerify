DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Server Git diff hard max. Recommended warning stays at 30,000.
MAX_DIFF_CHARS=50000
# 32+ characters. Encrypts the report token. Never expose this to the browser.
REPORT_TOKEN_SECRET=
# Production origin used for checkout success URLs.
APP_ORIGIN=https://changeverify.com
# Creem one-time product priced at $4.99.
# Test: https://test-api.creem.io
# Production: https://api.creem.io
CREEM_API_KEY=
CREEM_PRODUCT_ID=
CREEM_API_BASE=https://test-api.creem.io
